#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# `.github/workflows/gates.yml` runs the same checks since 2026-08-01, so this
# hook stopped being the only caller then. It is the fast one: it answers before
# a push rather than after it. This header said "this repository has no CI" until
# 2026-09-01, which had been wrong for a month.
#
# A gate nothing calls is a comment with an exit code, and that is not
# hypothetical here: manifest-is-true.sh was in neither caller for its whole
# life, and the omission it would have caught (a workload installed and
# undeclared) shipped past both.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-44s' "$name"
  if out=$(eval "$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    printf '%s\n' "$out" | sed 's/^/      /'
    fail=$((fail + 1))
  fi
}

echo "pre-push gate"
step "every gotcha is classified" "./scripts/gotchas-classified.sh"
step "the stack comes up closed" "./scripts/closed-by-default.sh"
step "cloud claims are dated and marked" "./scripts/portability-claims.sh"
step "every image is pinned or built here" "./scripts/pinned-images.sh"
step "every image is pinned by digest, and the admission policy is held to invariant 58" "./scripts/verified-images-are-enforced.sh"
step "every stream file is created by its writer before it starts (invariant 59)" "./scripts/stream-files-are-precreated.sh"
step "every manifest validates against the schema" "./scripts/manifests-valid.sh"
step "components.json says what is installed" "./scripts/manifest-is-true.sh"
step "node names are pinned by the install" "./scripts/node-name-is-pinned.sh"
step "every deploy path can set the trust domain" "./scripts/deploy-flags-agree.sh"
step "the AWS launcher takes every flag the GCP one takes" "./scripts/aws-takes-every-gcp-flag.sh"
step "no pod automounts the default SA token" "./scripts/no-sa-token-by-default.sh"
step "nothing operator-shaped is tracked" "./scripts/no-operator-files-tracked.sh"
step "every installer creates every Secret key the manifests read" "./scripts/secret-keys-agree.sh"
step "every installer reuses the cluster token before it installs" "./scripts/k3s-token-is-reused.sh"
step "the GCP preflight keeps what the operator wrote in terraform.tfvars" "./scripts/preflight-keeps-tfvars.sh"
step "the gateway's semantic cache is off in every install" "./scripts/gateway-cache-is-off.sh"
step "the gateway's declassify key is minted per cluster" "./scripts/declassify-is-keyed.sh"
step "a plane leaves a dead node and drains" "./scripts/planes-leave-a-dead-node.sh"
step "Longhorn releases a dead node's volumes" "./scripts/longhorn-releases-a-dead-node.sh"
step "the policy store keeps a readable replica" "./scripts/policy-store-survives-a-partition.sh"
step "a deploy refuses an old policy-db claim before apply" "./scripts/policy-store-refuses-an-old-claim.sh"
step "the hub entry routes exactly the eight allowed paths" "./scripts/hub-entry-is-narrow.sh"
step "Felyx reaches its model through the gateway" "./scripts/felyx-through-the-gateway.sh"
step "vouchryx runs agents-only in the default install" "./scripts/vouchryx-runs-agents-only.sh"
step "closing a retained reservation is off by default" "./scripts/closure-off-by-default.sh"
step "the typed data mode is honest" "./scripts/typed-mode-is-honest.sh"
step "the typed-answer door is minted by the deploy" "./scripts/typed-door-is-minted.sh"
step "the gateway caps what a run may declare" "./scripts/run-budget-ceiling-is-set.sh"
step "the agent firewall runs in enforce by default" "./scripts/firewall-is-enforce-by-default.sh"
step "the PII scanners run in shadow by default" "./scripts/pii-is-shadow-by-default.sh"
step "client keys and the identity map are checked first" "./scripts/identity-files-are-checked.sh"
step "the gateway requires client keys, minted when none are given" "./scripts/metered-doors-require-keys.sh"
step "the MCP broker blocks raw secrets and asks the policy plane" "./scripts/broker-blocks-raw-secrets.sh"
step "the gateway's policy-plane key is a pep, on a new cluster and on one installed again" "./scripts/wardryx-gateway-key-is-pep.sh"
step "the provider key is held by the gateway from a file, and no other container holds one" "./scripts/no-provider-key-outside-the-gateway.sh"
step "agent tokens are required at the doors, with one audience and a closed revocation list" "./scripts/agent-tokens-are-required.sh"
step "a static client key is admitted only from the named lists" "./scripts/static-keys-are-named.sh"
step "wardryx verifies agent tokens and proofs" "./scripts/wardryx-verifies-agent-tokens.sh"
step "every bus file is a name the readers accept" "./scripts/bus-names-match-the-source-rule.sh"
step "the chain verifier watches the bus" "./scripts/chain-verifier-watches-the-bus.sh"
step "every mounted key is readable by its pod" "./scripts/mounted-keys-are-readable.sh"
step "every client key example has a bare key id" "./scripts/client-key-ids-are-bare.sh"
step "no quote of the owner in a public file" "./scripts/no-owner-quotes.sh"
step "a read-only container that needs a temp has one" "./scripts/read-only-root-has-a-temp.sh"
step "a secret is minted from a bounded read" "./scripts/gen-is-bounded.sh"
step "a cost report refuses an unknown machine rate" "./scripts/cost-live-refuses-unknown-rates.sh"
step "cluster DNS keeps a replica through a drain" "./scripts/cluster-dns-has-a-budget.sh"
step "every node stops its pods before its network goes" "./scripts/nodes-stop-their-pods-first.sh"
step "every shell script parses under the bash a Mac ships" "./scripts/shell-scripts-parse.sh"
step "node checks read only their own answer" "./scripts/node-checks-read-their-own-answer.sh"
step "every k3s server starts with --secrets-encryption" "./scripts/servers-encrypt-secrets.sh"
step "no secret value on any command line" "./scripts/no-secret-on-argv.sh"
step "every cloud host key is verified before the first connection" "./scripts/hostkeys-are-verified.sh"
step "a stdin-fed remote command reads its stdin once" "./scripts/stdin-is-read-once.sh"
step "the risk hold follows --typed-risk-signal (invariant 65)" "./scripts/risk-hold-follows-the-flag.sh"
step "the CostCrew ceiling is validated and written after apply (invariant 66)" "./scripts/costcrew-ceiling-is-set.sh"
step "every workflow checkout of another repository is a full commit (invariant 68)" "./scripts/workflow-checkouts-are-pinned.sh"
step "hub/add-site.sh reads a digest-pinned tokenfuse-cloud image" "./scripts/hub-add-site-reads-the-pinned-image.sh"
step "the console approver key is minted once and wardryx verifies with it (invariant 67)" "./scripts/approver-key-is-minted.sh"
step "the teeth shards cover every case once" "./scripts/teeth-shards-cover-every-case.sh"

echo
if [ "$fail" -ne 0 ]; then
  echo "pre-push: $fail of $((pass + fail)) checks failed. Nothing pushed."
  exit 1
fi
echo "pre-push: all $pass checks passed."
