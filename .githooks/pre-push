#!/usr/bin/env bash
#
# Local gate before anything leaves this machine.
#
# `.github/workflows/gates.yml` runs the same checks since 2026-08-01, so this
# hook stopped being the only caller then. It is the fast one: it answers before
# a push rather than after it. This header said "this repository has no CI" until
# 2026-09-01, which had been wrong for a month.
#
# A gate nothing calls is a comment with an exit code, and that is not
# hypothetical here: manifest-is-true.sh was in neither caller for its whole
# life, and the omission it would have caught (a workload installed and
# undeclared) shipped past both.
#
# Install (once):  git config core.hooksPath .githooks
# Skip (rarely):   git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pass=0
fail=0

step() {
  local name="$1"
  shift
  printf '  %-44s' "$name"
  if out=$(eval "$@" 2>&1); then
    printf 'ok\n'
    pass=$((pass + 1))
  else
    printf 'FAIL\n'
    printf '%s\n' "$out" | sed 's/^/      /'
    fail=$((fail + 1))
  fi
}

echo "pre-push gate"
step "every gotcha is classified" "./scripts/gotchas-classified.sh"
step "the stack comes up closed" "./scripts/closed-by-default.sh"
step "cloud claims are dated and marked" "./scripts/portability-claims.sh"
step "every image is pinned or built here" "./scripts/pinned-images.sh"
step "every manifest validates against the schema" "./scripts/manifests-valid.sh"
step "components.json says what is installed" "./scripts/manifest-is-true.sh"
step "node names are pinned by the install" "./scripts/node-name-is-pinned.sh"
step "every deploy path can set the trust domain" "./scripts/deploy-flags-agree.sh"
step "no pod automounts the default SA token" "./scripts/no-sa-token-by-default.sh"
step "nothing operator-shaped is tracked" "./scripts/no-operator-files-tracked.sh"
step "every installer creates every Secret key the manifests read" "./scripts/secret-keys-agree.sh"
step "every installer reuses the cluster token before it installs" "./scripts/k3s-token-is-reused.sh"
step "the GCP preflight keeps what the operator wrote in terraform.tfvars" "./scripts/preflight-keeps-tfvars.sh"
step "the gateway's semantic cache is off in every install" "./scripts/gateway-cache-is-off.sh"
step "the gateway's declassify key is minted per cluster" "./scripts/declassify-is-keyed.sh"
step "a plane leaves a dead node and drains" "./scripts/planes-leave-a-dead-node.sh"
step "Longhorn releases a dead node's volumes" "./scripts/longhorn-releases-a-dead-node.sh"
step "the hub entry routes exactly the seven allowed paths" "./scripts/hub-entry-is-narrow.sh"
step "Felyx reaches its model through the gateway" "./scripts/felyx-through-the-gateway.sh"
step "delegation is off by default" "./scripts/delegation-off-by-default.sh"
step "the typed data mode is honest" "./scripts/typed-mode-is-honest.sh"
step "the gateway caps what a run may declare" "./scripts/run-budget-ceiling-is-set.sh"
step "every bus file is a name the readers accept" "./scripts/bus-names-match-the-source-rule.sh"
step "the chain verifier watches the bus" "./scripts/chain-verifier-watches-the-bus.sh"
step "every mounted key is readable by its pod" "./scripts/mounted-keys-are-readable.sh"

echo
if [ "$fail" -ne 0 ]; then
  echo "pre-push: $fail of $((pass + fail)) checks failed. Nothing pushed."
  exit 1
fi
echo "pre-push: all $pass checks passed."
