kubeconfig.yaml
kubeconfig-*.yaml
.DS_Store

# terraform: state holds resource ids and can hold sensitive values
cloud/**/.terraform/
cloud/**/terraform.tfstate
cloud/**/terraform.tfstate.*
cloud/**/*.tfvars
cloud/**/kubeconfig.yaml
cloud/**/tfplan
kubeconfig-tunnel.yaml

# The operator's own two names. site.example.yaml is the tracked template.
tunnel/site.yaml

# Issued device configs. up.sh writes <console_domain>.conf beside itself, and
# it carries that device's PRIVATE key. Committing one hands a way in to
# everyone who can read the repository.
*.conf
